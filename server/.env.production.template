# Production Environment Configuration for Chttrix Backend

# Server Configuration
NODE_ENV=production
PORT=8080

# MongoDB Atlas Configuration
# Replace with your MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chttrix?retryWrites=true&w=majority

# JWT Secrets (KEEP THESE SECRET AND SECURE!)
# Generated secure 128-character secrets - DO NOT SHARE OR COMMIT TO VERSION CONTROL
ACCESS_TOKEN_SECRET=fb6e9ddfc68572d7fc5f45ffe6a0549c29a53e66d02b14a23806eeb4932aa2420155dbb7395a649f7e0dde06e5c876fd8b75f6655a1f6f67fa0befec97877c64
REFRESH_TOKEN_SECRET=d4d2c38b0f8e6583cd13dfd4d787a406485533b16037454b086a5a156b1d3f79d0c67b0c3a25b7fdf73c30d5aa1c22271f23499595d244483a96ec019e794315
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend URL (Your deployed frontend domain)
# Example: https://chttrix.vercel.app
FRONTEND_URL=https://chttrix.vercel.app

# Backend URL (Your deployed backend URL - CRITICAL for OAuth callbacks)
# Example: https://chttrix-api-xxxx.a.run.app
BACKEND_URL=https://your-backend-url.a.run.app

# Email (invites, password resets, notifications). Check with: npm run email:check
# 1. Brevo HTTP API (recommended): API v3 key from Brevo > SMTP & API > API Keys ("xkeysib-...")
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Sender: must be on a domain you authenticated in Brevo (SPF + DKIM). Never a gmail.com/outlook.com
# address: their DMARC policy makes receivers reject mail relayed through Brevo.
# Accepts "noreply@yourdomain.com" or "Chttrix <noreply@yourdomain.com>".
EMAIL_FROM=Chttrix <noreply@yourdomain.com>
# 2. Optional SMTP used if the API call fails. For Brevo: smtp-relay.brevo.com, your
#    "@smtp-brevo.com" login, and an SMTP key ("xsmtpsib-...", not the account password).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=xsmtpsib-your-smtp-key
# 3. Optional last-resort SMTP (e.g. Gmail with an app password)
SMTP_FALLBACK_HOST=smtp.gmail.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER=your_email@gmail.com
SMTP_FALLBACK_PASS=your_gmail_app_password

# OAuth Configuration (REQUIRED for Google OAuth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth (Optional - only if using these providers)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# E2EE Configuration (REQUIRED for encryption features)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_KEK=your_64_character_hex_key_here
CRYPTO_KEK_ACTIVE_VERSION=1
CRYPTO_KEK_V1=your_64_character_hex_key_version_1
CRYPTO_KEK_V2=your_64_character_hex_key_version_2

# Twilio (Optional - for SMS OTP)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# AI Features (Optional)
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud Storage — File/Image/Video/Voice Uploads
# Backend runs on Cloud Run with chttrix-runtime service account attached.
# ADC (Application Default Credentials) is automatically available — no key file needed.
# Just set the project and bucket name:
GCP_PROJECT_ID=chttrix-prod
GCS_BUCKET_NAME=chttrix-uploads

# Feature flags: half-built areas stay hidden unless listed (billing, sso, integrations, community, or "all")
FEATURES_ENABLED=

# Huddles (voice calls). STUN alone fails behind strict NATs/corporate firewalls: configure ONE TURN source.
#   Managed (Cloudflare Realtime TURN):  CLOUDFLARE_TURN_KEY_ID + CLOUDFLARE_TURN_API_TOKEN
#   Self-hosted coturn (static-auth-secret):  TURN_URLS + TURN_SECRET
#   Static credentials (Metered, Twilio, etc.):  TURN_URLS + TURN_USERNAME + TURN_CREDENTIAL
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional: STUN_URLS (comma list), TURN_TTL_SECONDS=86400, ICE_TRANSPORT_POLICY=relay (force TURN to test it)
# Mesh calls get heavy past ~6 people; this caps a huddle's size until calls move to a media server.
HUDDLE_MAX_PARTICIPANTS=6
