# Production environment for the Oruinwan API server.
# Copy to server/.env (or your platform's secret store) and replace every value.
# Never commit the filled-in copy. server/.env.example documents every variable in detail.
#
# Generate each secret with:   openssl rand -hex 32

# ─── Server ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
# all = API + realtime + jobs + uploads in one process. Split roles need REDIS_URL (see docs/SCALING.md).
PROCESS_ROLE=all

# Public URLs. FRONTEND_URL must match the web origin exactly (CORS, cookies, OAuth callbacks).
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com

# ─── PostgreSQL + pgvector (REQUIRED) ───────────────────────────────────────
# Identity, tasks, logs, AI embeddings and the event outbox. Migrations run on boot.
DATABASE_URL=postgres://oruinwan:change-me@db.example.com:5432/oruinwan
PG_SSL=true
# PG_POOL_SIZE=10
TASKS_STORE=pg

# ─── MongoDB (REQUIRED) ─────────────────────────────────────────────────────
# Messages, channels, notes, notifications. Atlas or self-hosted.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/oruinwan?retryWrites=true&w=majority
# Run `node scripts/syncIndexes.js` on deploy instead of building indexes at boot.
MONGO_AUTO_INDEX=false

# ─── Redis (required for more than one server process) ──────────────────────
# Socket.IO fan-out, shared presence, job locks, event stream. Use rediss:// for TLS.
REDIS_URL=rediss://default:change-me@redis.example.com:6379

# ─── Object storage, S3-compatible (REQUIRED in production) ─────────────────
# AWS S3: leave S3_ENDPOINT empty and S3_FORCE_PATH_STYLE=false.
# MinIO, RustFS, Cloudflare R2, Backblaze B2: set S3_ENDPOINT, usually with path-style on.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=oruinwan-uploads
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=false

# ─── Auth secrets (REQUIRED) ────────────────────────────────────────────────
ACCESS_TOKEN_SECRET=change-me-64-hex-characters
REFRESH_TOKEN_SECRET=change-me-64-hex-characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Encryption keys (REQUIRED) ─────────────────────────────────────────────
# Each value is exactly 64 hex characters. Losing them makes stored secrets unreadable: back them up.
SERVER_KEK=change-me-64-hex-characters
CRYPTO_KEK_ACTIVE_VERSION=1
CRYPTO_KEK_V1=change-me-64-hex-characters
CRYPTO_KEK_V2=

# ─── OAuth ──────────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID is required at boot; the others are optional.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── Email ──────────────────────────────────────────────────────────────────
# Tried in order: Brevo API, SMTP_*, SMTP_FALLBACK_*. The sender domain needs SPF and DKIM.
BREVO_API_KEY=
EMAIL_FROM=Oruinwan <noreply@example.com>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=

# ─── SMS one-time passwords (optional) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── AI ─────────────────────────────────────────────────────────────────────
# Default: your own OpenAI-compatible model server (vLLM or Ollama).
AI_PROVIDER=local_llm
LOCAL_LLM_BASE_URL=https://models.example.internal/v1
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_EMBED_MODEL=nomic-embed-text
# LOCAL_LLM_API_KEY=
# Hosted alternatives: AI_PROVIDER=gemini|openai|anthropic plus the matching key.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Separate AI process (optional): same token on both sides.
# AI_SERVICE_URL=http://ai.internal:8090
# AI_SERVICE_TOKEN=change-me

# ─── Log retention in days (0 = keep forever) ───────────────────────────────
AUDIT_LOG_RETENTION_DAYS=0
HISTORY_LOG_RETENTION_DAYS=365
ACTIVITY_RETENTION_DAYS=180
SECURITY_AUDIT_RETENTION_DAYS=365

# ─── Feature flags ──────────────────────────────────────────────────────────
# Half-built areas stay hidden unless listed: billing, sso, integrations, community, or all.
FEATURES_ENABLED=

# ─── Huddles (voice and video) ──────────────────────────────────────────────
# Configure ONE TURN source so calls work behind strict NATs and firewalls.
#   Cloudflare Realtime TURN:  CLOUDFLARE_TURN_KEY_ID + CLOUDFLARE_TURN_API_TOKEN
#   Self-hosted coturn:        TURN_URLS + TURN_SECRET
#   Static credentials:        TURN_URLS + TURN_USERNAME + TURN_CREDENTIAL
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
HUDDLE_MAX_PARTICIPANTS=6
