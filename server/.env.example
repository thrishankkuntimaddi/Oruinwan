# Server Configuration
PORT=8080
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chttrix?retryWrites=true&w=majority

# JWT Configuration (REQUIRED - generate secure secrets)
ACCESS_TOKEN_SECRET=your_access_token_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# URLs (REQUIRED)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Email (invites, password resets, notifications). Check with: npm run email:check
# 1. Brevo HTTP API (recommended): API v3 key from Brevo > SMTP & API > API Keys ("xkeysib-...")
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Sender: must be on a domain you authenticated in Brevo (SPF + DKIM). Never a gmail.com/outlook.com
# address: their DMARC policy makes receivers reject mail relayed through Brevo.
# Accepts "noreply@yourdomain.com" or "Oruinwan <noreply@yourdomain.com>".
EMAIL_FROM=Oruinwan <noreply@yourdomain.com>
# 2. Optional SMTP used if the API call fails. For Brevo: smtp-relay.brevo.com, your
#    "@smtp-brevo.com" login, and an SMTP key ("xsmtpsib-...", not the account password).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=xsmtpsib-your-smtp-key
# 3. Optional last-resort SMTP (e.g. Gmail with an app password)
SMTP_FALLBACK_HOST=smtp.gmail.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER=your_email@gmail.com
SMTP_FALLBACK_PASS=your_gmail_app_password

# OAuth Configuration (REQUIRED for Google login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth (Optional - only if using these providers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Twilio Configuration (Optional - for OTP SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# E2EE Configuration (REQUIRED for encryption features)
SERVER_KEK=your_64_character_hex_key_for_server_encryption
CRYPTO_KEK_ACTIVE_VERSION=1
CRYPTO_KEK_V1=your_64_character_hex_key_version_1
CRYPTO_KEK_V2=your_64_character_hex_key_version_2

# AI — Oruinwan AI (our own engine; no third-party AI service by default)
# The engine is any OpenAI-compatible model server we run ourselves:
#   local dev : Ollama on this machine   ->  ollama serve  +  ollama pull qwen2.5:3b  +  ollama pull nomic-embed-text
#   cloud     : vLLM or Ollama on a GPU server -> point LOCAL_LLM_BASE_URL at it (and pick bigger models)
AI_PROVIDER=local_llm
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
# LOCAL_LLM_FAST_MODEL=           (one-shot helpers; defaults to LOCAL_LLM_MODEL)
# LOCAL_LLM_CODE_MODEL=           (code reviews, e.g. qwen2.5-coder:7b; defaults to LOCAL_LLM_MODEL)
LOCAL_EMBED_MODEL=nomic-embed-text
# LOCAL_EMBED_BASE_URL=           (defaults to LOCAL_LLM_BASE_URL)
# LOCAL_LLM_API_KEY=              (only if your model server requires one)
# AI_RATE_LIMIT_PER_MIN=40   AI_MAX_OUTPUT_TOKENS=2000   AI_TIMEOUT_MS=120000   AI_MAX_TOOL_ROUNDS=4
#
# Optional third-party providers, only used when selected here (AI_PROVIDER=gemini|openai|anthropic)
# or by a workspace admin in Settings → AI:
# GEMINI_API_KEY=   GEMINI_CHAT_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=   OPENAI_CHAT_MODEL=gpt-4o-mini   OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=   ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# Redis (Optional - required as soon as you run more than one server process)
# When set: Socket.IO uses Redis pub/sub, presence and live huddles are shared across
# instances, and scheduled jobs (reminders, digests, retention, automations) run on
# exactly one instance per interval. When unset: single-instance mode (dev / one dyno).
# Format: redis://[:password@]host[:port]  (rediss:// for TLS)
REDIS_URL=

# What this process serves (docs/SCALING.md). all = today's single server.
#   all | api (HTTP only) | realtime (sockets + HTTP, no jobs) | worker (jobs only, /api/health)
#   | storage (uploads/downloads only)
# Anything but "all" needs REDIS_URL.
PROCESS_ROLE=all

# PostgreSQL (REQUIRED): identity (users, companies, workspaces, memberships, keys), tasks, logs,
# embeddings and the event outbox. Migrations in server/db/migrations run on boot (PG_AUTO_MIGRATE=false to
# run `node scripts/migrate.js` yourself). Matches docker-compose.yml defaults:
DATABASE_URL=postgres://oruinwan:oruinwan-dev@localhost:5432/oruinwan
# PG_POOL_SIZE=10   PG_SSL=false
# Tasks, projects, sprints and milestones: mongo (default) or pg.
TASKS_STORE=pg
# LOG_STORE=both    (both = Mongo + Postgres mirror for audit/compliance/security logs; mongo = mirror off)

# MongoDB tuning (all optional)
# MONGO_POOL_SIZE=20            max connections per process
# MONGO_MIN_POOL_SIZE=0
# MONGO_AUTO_INDEX=true         set false in production and run `node scripts/syncIndexes.js` on deploy
# MONGO_READ_REPLICAS=false     true sends audit/analytics/AI-knowledge reads to secondaries (replica set only)

# Retention for ever-growing log collections, in days. 0 = keep forever (default).
# Creates/updates/drops a TTL index named retention_ttl at boot. Suggested: 365 / 180 / 365; leave
# AUDIT_LOG_RETENTION_DAYS at 0 unless your compliance policy allows deletion.
AUDIT_LOG_RETENTION_DAYS=0
HISTORY_LOG_RETENTION_DAYS=0
ACTIVITY_RETENTION_DAYS=0
SECURITY_AUDIT_RETENTION_DAYS=0

# AI knowledge search runs on PostgreSQL + pgvector (db/migrations/0003_ai_embeddings.sql); nothing to set
# beyond DATABASE_URL. The embedding model must produce 768-dim vectors (nomic-embed-text).

# Standalone AI service (ai/server.js, `cd ai && npm start`). Unset = AI runs inside this process.
# AI_SERVICE_URL=http://localhost:8090
# AI_SERVICE_TOKEN=change-me-long-random      (same value in the AI process)
# AI_REMOTE_TIMEOUT_MS=180000
# AI process env: AI_STANDALONE=1 AI_PORT=8090 AI_SERVICE_TOKEN=... API_INTERNAL_URL=http://localhost:8080 + LOCAL_LLM_*

# Event bus (src/shared/events). With REDIS_URL + DATABASE_URL events go PostgreSQL outbox -> Redis Stream
# "oruinwan:events"; with Redis only they go straight to the stream; with neither they stay in-process.
# OUTBOX_RETENTION_DAYS=7   published outbox rows kept this long for debugging

# Dedicated databases for large tenants (stage 3, optional). JSON map of companyId -> Mongo URI;
# src/shared/tenantDb.js resolves models against it. Everything else stays in MONGO_URI.
# TENANT_DB_MAP={"64f1c2...":"mongodb+srv://.../acme"}

# Object storage (REQUIRED for production and for any multi-instance deploy: local disk is not shared).
# S3-compatible: the s3 service in docker-compose.yml locally, any S3 service later. Without S3_* the
# server falls back to local disk (development/tests only; it warns in production). The bucket is
# created on boot if missing.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=oruinwan-uploads
S3_ACCESS_KEY=oruinwan
S3_SECRET_KEY=oruinwan-dev-secret
S3_FORCE_PATH_STYLE=true
# STORAGE_DRIVER=s3|local   (force a driver regardless of the variables above)

# Feature flags: half-built areas stay hidden unless listed (billing, sso, integrations, community, or "all")
FEATURES_ENABLED=

# Developer integrations (GitHub / Jira / Zoom; needs FEATURES_ENABLED=integrations). Credentials are
# entered per workspace in the app and sealed under SERVER_KEK; these are optional server-wide knobs.
# Public base URL shown in webhook URLs (e.g. an ngrok / cloudflared tunnel in development). Defaults to BACKEND_URL.
INTEGRATIONS_PUBLIC_URL=
# GitHub Enterprise API base (default https://api.github.com)
GITHUB_API_URL=
# AI pull request reviews per workspace per hour, and the diff budget sent to the local model
INTEGRATIONS_AI_REVIEWS_PER_HOUR=30
INTEGRATIONS_REVIEW_DIFF_CHARS=14000
INTEGRATIONS_REVIEW_FILE_CHARS=3500
# Incoming webhook deliveries per workspace+provider per minute
INTEGRATIONS_WEBHOOK_PER_MIN=600
# Zoom endpoints (override only for testing)
ZOOM_OAUTH_URL=
ZOOM_API_URL=

# Huddles (voice calls). STUN alone fails behind strict NATs/corporate firewalls: configure ONE TURN source.
#   Managed (Cloudflare Realtime TURN):  CLOUDFLARE_TURN_KEY_ID + CLOUDFLARE_TURN_API_TOKEN
#   Self-hosted coturn (static-auth-secret):  TURN_URLS + TURN_SECRET
#   Static credentials (Metered, Twilio, etc.):  TURN_URLS + TURN_USERNAME + TURN_CREDENTIAL
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional: STUN_URLS (comma list), TURN_TTL_SECONDS=86400, ICE_TRANSPORT_POLICY=relay (force TURN to test it)
# Mesh calls get heavy past ~6 people; this caps a huddle's size until calls move to a media server.
HUDDLE_MAX_PARTICIPANTS=6
