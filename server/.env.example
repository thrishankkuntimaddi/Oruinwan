# Server Configuration
PORT=8080
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/chttrix?retryWrites=true&w=majority

# JWT Configuration (REQUIRED - generate secure secrets)
ACCESS_TOKEN_SECRET=your_access_token_secret_here_min_32_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# URLs (REQUIRED)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Email (invites, password resets, notifications). Check with: npm run email:check
# 1. Brevo HTTP API (recommended): API v3 key from Brevo > SMTP & API > API Keys ("xkeysib-...")
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Sender: must be on a domain you authenticated in Brevo (SPF + DKIM). Never a gmail.com/outlook.com
# address: their DMARC policy makes receivers reject mail relayed through Brevo.
# Accepts "noreply@yourdomain.com" or "Oruinwan <noreply@yourdomain.com>".
EMAIL_FROM=Oruinwan <noreply@yourdomain.com>
# 2. Optional SMTP used if the API call fails. For Brevo: smtp-relay.brevo.com, your
#    "@smtp-brevo.com" login, and an SMTP key ("xsmtpsib-...", not the account password).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=xsmtpsib-your-smtp-key
# 3. Optional last-resort SMTP (e.g. Gmail with an app password)
SMTP_FALLBACK_HOST=smtp.gmail.com
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER=your_email@gmail.com
SMTP_FALLBACK_PASS=your_gmail_app_password

# OAuth Configuration (REQUIRED for Google login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth (Optional - only if using these providers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Twilio Configuration (Optional - for OTP SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# E2EE Configuration (REQUIRED for encryption features)
SERVER_KEK=your_64_character_hex_key_for_server_encryption
CRYPTO_KEK_ACTIVE_VERSION=1
CRYPTO_KEK_V1=your_64_character_hex_key_version_1
CRYPTO_KEK_V2=your_64_character_hex_key_version_2

# AI — Oruinwan AI (our own engine; no third-party AI service by default)
# The engine is any OpenAI-compatible model server we run ourselves:
#   local dev : Ollama on this machine   ->  ollama serve  +  ollama pull qwen2.5:3b  +  ollama pull nomic-embed-text
#   cloud     : vLLM or Ollama on a GPU server -> point LOCAL_LLM_BASE_URL at it (and pick bigger models)
AI_PROVIDER=local_llm
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
# LOCAL_LLM_FAST_MODEL=           (one-shot helpers; defaults to LOCAL_LLM_MODEL)
# LOCAL_LLM_CODE_MODEL=           (code reviews, e.g. qwen2.5-coder:7b; defaults to LOCAL_LLM_MODEL)
LOCAL_EMBED_MODEL=nomic-embed-text
# LOCAL_EMBED_BASE_URL=           (defaults to LOCAL_LLM_BASE_URL)
# LOCAL_LLM_API_KEY=              (only if your model server requires one)
# AI_RATE_LIMIT_PER_MIN=40   AI_MAX_OUTPUT_TOKENS=2000   AI_TIMEOUT_MS=120000   AI_MAX_TOOL_ROUNDS=4
#
# Optional third-party providers, only used when selected here (AI_PROVIDER=gemini|openai|anthropic)
# or by a workspace admin in Settings → AI:
# GEMINI_API_KEY=   GEMINI_CHAT_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=   OPENAI_CHAT_MODEL=gpt-4o-mini   OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=   ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# Redis (Optional - for horizontal scaling across multiple server instances)
# When set: Socket.IO uses Redis pub/sub — events propagate across all instances.
# When unset: server runs in single-instance mode (safe for dev / Railway single dyno).
# Format: redis://[:password@]host[:port]
REDIS_URL=

# Google Cloud Storage (REQUIRED for file/image/video/voice uploads in production)
# On Cloud Run the chttrix-runtime service account is auto-picked up via ADC.
# These two vars tell the SDK which project and bucket to use.
GCP_PROJECT_ID=chttrix-prod
GCS_BUCKET_NAME=chttrix-uploads

# Feature flags: half-built areas stay hidden unless listed (billing, sso, integrations, community, or "all")
FEATURES_ENABLED=

# Huddles (voice calls). STUN alone fails behind strict NATs/corporate firewalls: configure ONE TURN source.
#   Managed (Cloudflare Realtime TURN):  CLOUDFLARE_TURN_KEY_ID + CLOUDFLARE_TURN_API_TOKEN
#   Self-hosted coturn (static-auth-secret):  TURN_URLS + TURN_SECRET
#   Static credentials (Metered, Twilio, etc.):  TURN_URLS + TURN_USERNAME + TURN_CREDENTIAL
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_URLS=
TURN_SECRET=
TURN_USERNAME=
TURN_CREDENTIAL=
# Optional: STUN_URLS (comma list), TURN_TTL_SECONDS=86400, ICE_TRANSPORT_POLICY=relay (force TURN to test it)
# Mesh calls get heavy past ~6 people; this caps a huddle's size until calls move to a media server.
HUDDLE_MAX_PARTICIPANTS=6
