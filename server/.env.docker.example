# Oruniwan Docker Environment Configuration
# Copy this file to .env and update values as needed
# DO NOT commit .env file to version control

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=8080
NODE_ENV=development

# ============================================================================
# POSTGRESQL DATABASE
# ============================================================================
# Connection details for PostgreSQL service
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=oruniwan

# Optional: Full PostgreSQL connection string
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/oruniwan

# ============================================================================
# MONGODB CONFIGURATION
# ============================================================================
# Connection details for MongoDB service
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_DB=oruniwan
MONGO_PORT=27017

# Full MongoDB URI (auto-generated from above)
# MONGO_URI=mongodb://admin:password@mongo:27017/oruniwan?authSource=admin

# ============================================================================
# REDIS CACHE
# ============================================================================
# Connection details for Redis service
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_PORT=6379

# ============================================================================
# THIRD-PARTY SERVICES (External)
# ============================================================================
# Gemini AI API
GEMINI_API_KEY=your-gemini-api-key-here

# RabbitMQ or other message broker
RABBITMQ_URL=amqp://user:pass@rabbitmq-host:5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Twilio (if using SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AWS S3 (if using S3 for file storage)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Google OAuth (if using Google authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Session/JWT configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-super-secret-session-key

# CORS configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@example.com

# ============================================================================
# PRODUCTION-ONLY SETTINGS
# ============================================================================
# Uncomment and set these when NODE_ENV=production

# SECURE_COOKIES=true
# HTTPS_ONLY=true
# HSTS_MAX_AGE=31536000

# Database SSL (for cloud databases)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# ============================================================================
# DOCKER-SPECIFIC SETTINGS
# ============================================================================
# Keep these for Docker deployments
DOCKER_NETWORK=oruniwan-network
COMPOSE_PROJECT_NAME=oruniwan
