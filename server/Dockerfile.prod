# Production-optimized Dockerfile for Oruniwan API server
#
# Build from the server directory:
#   docker build -f Dockerfile.prod -t oruniwan-server:latest .
#
# Multi-stage build optimizes final image size and excludes dev dependencies

FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:20-alpine
LABEL maintainer="Oruniwan Team"
LABEL description="Oruniwan API Server"

ENV NODE_ENV=production \
    NODE_OPTIONS="--max-old-space-size=512"

WORKDIR /app

# Copy production dependencies only
COPY --from=deps /app/node_modules ./node_modules

# Server application code
COPY package.json server.js ./
COPY src ./src
COPY config ./config
COPY constants ./constants
COPY models ./models
COPY routes ./routes
COPY utils ./utils

# Create uploads directory and set permissions
RUN mkdir -p /app/uploads && \
    addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "const port = process.env.PORT || 8080; require('http').get(\`http://localhost:\${port}/api/health\`, (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["node", "server.js"]
