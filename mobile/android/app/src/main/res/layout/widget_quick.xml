            </FrameLayout>
            <TextView android:id="@+id/quick_c_name_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#0A0A0C" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/quick_c_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal" android:visibility="invisible">
