<?xml version="1.0" encoding="utf-8"?>
<!-- Generated layout for an Oruinwan home-screen widget (see widgets/WidgetRenderer.java).
     Only view types widgets allow: LinearLayout, FrameLayout, TextView, ImageView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_glass_light">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
        <TextView android:id="@+id/hud_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Huddles" android:textSize="15sp" android:textStyle="bold" android:textColor="#0A0A0C" />
        <TextView android:id="@+id/hud_count" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_marginStart="6dp" android:background="@drawable/widget_badge" android:gravity="center" android:minWidth="18dp" android:paddingStart="5dp" android:paddingEnd="5dp" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:visibility="gone" />
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView android:id="@+id/hud_sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#5A5A60" android:maxLines="1" android:ellipsize="end" />
        
    </LinearLayout>
    <LinearLayout android:id="@+id/hud_live_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
        <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_live_dot" android:contentDescription="Live" />
        <TextView android:id="@+id/hud_live_title_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#0A0A0C" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/hud_live_people_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#5A5A60" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/hud_live_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
        <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_live_dot" android:contentDescription="Live" />
        <TextView android:id="@+id/hud_live_title_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#0A0A0C" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/hud_live_people_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#5A5A60" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/hud_live_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp" android:visibility="gone">
        <ImageView android:layout_width="8dp" android:layout_height="8dp" android:src="@drawable/widget_live_dot" android:contentDescription="Live" />
        <TextView android:id="@+id/hud_live_title_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:textSize="13sp" android:textStyle="bold" android:textColor="#0A0A0C" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/hud_live_people_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#5A5A60" android:maxLines="1" android:ellipsize="end" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/hud_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_chip_light" android:visibility="gone">
        <TextView android:id="@+id/hud_next_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEXT MEETING" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.1" android:textColor="#5A5A60" />
        <TextView android:id="@+id/hud_next_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#0A0A0C" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/hud_next_when" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#5A5A60" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout><TextView android:id="@+id/hud_empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="13sp" android:textColor="#5A5A60" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <TextView android:id="@+id/hud_start" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:background="@drawable/widget_chip_light" android:gravity="center" android:text="Start a huddle" android:textSize="12sp" android:textStyle="bold" android:textColor="#0A0A0C" />
    </LinearLayout>
</LinearLayout>
