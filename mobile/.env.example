# Copy to .env for local builds. Every VITE_ value ends up inside the app bundle,
# so only public, client-side values belong here (never server secrets).

# The Oruinwan server the app talks to (no one types a server address). Empty: http://localhost:8080.
# Testing on a real phone against this computer: use its network address, e.g. http://192.168.1.20:8080.
VITE_SERVER_URL=

# Where the app looks for a newer Android build when Firebase Remote Config has no answer.
# Must be publicly readable. Default: latest.json on this repo's newest GitHub release.
VITE_UPDATE_MANIFEST_URL=

# Firebase web config (Project settings → General → Your apps → Web app).
# Used for Remote Config (feature flags + update notices) and optional anonymous analytics.
# Leave empty to build without Firebase; the app then uses built-in defaults.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Not a VITE_ value: read by the native builds, not the bundle. The web app's host (no https://),
# so workspace invitation links (https://<host>/join-workspace?token=…) open the phone app.
# Android: environment variable or `oruinwanWebHost` in android/gradle.properties.
# iOS: the ORUINWAN_WEB_HOST build setting (App target). Default: app.example.com (a placeholder).
# ORUINWAN_WEB_HOST=
