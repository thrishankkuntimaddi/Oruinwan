{
  "name": "chttrix-collab",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "e2e"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm run server\" \"npm run client\"",
    "client": "cd client && npm run preview",
    "server": "cd server && npm run dev",
    "install-all": "npm install && cd client && npm install && cd ../server && npm install",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client && npm run lint:ai && npm run lint:sdk",
    "test": "npm test --workspace=server && npm test --workspace=client",
    "build": "npm run build --workspace=client",
    "lint:ai": "cd ai && eslint .",
    "lint:sdk": "cd sdk && eslint .",
    "test:e2e": "npm test --workspace=e2e",
    "dev:services": "bash scripts/dev-services.sh",
    "dev:status": "bash scripts/dev-status.sh",
    "dev:all": "bash scripts/dev-services.sh && npm run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
