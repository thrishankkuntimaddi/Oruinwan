{
  "name": "chttrix-collab",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "e2e"
  ],
  "scripts": {
    "start": "yarn dev",
    "dev": "concurrently -k -n server,client -c blue,magenta \"yarn server\" \"yarn client\"",
    "client": "cd client && npm run preview",
    "server": "cd server && npm run dev",
    "install-all": "yarn install",
    "lint": "yarn workspace server lint && yarn workspace client lint && yarn lint:ai && yarn lint:sdk",
    "test": "yarn workspace server test && yarn workspace client test",
    "build": "yarn workspace client build",
    "lint:ai": "cd ai && eslint .",
    "lint:sdk": "cd sdk && eslint .",
    "test:e2e": "yarn workspace e2e test",
    "dev:services": "bash scripts/dev-services.sh",
    "dev:status": "bash scripts/dev-status.sh",
    "dev:all": "bash scripts/dev-services.sh && yarn dev"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
