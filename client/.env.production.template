# Production build settings for the Oruinwan web client.
# Every VITE_ variable is bundled into the browser build: never put secrets here.

# When the API server also serves the built client (one origin):
VITE_API_URL=/api
# VITE_BACKEND_URL is the public origin: the socket and some pages need an absolute URL.
VITE_BACKEND_URL=https://app.example.com
# When the client is hosted separately (CDN, Vercel, S3 + CloudFront), use the API's public URL:
# VITE_API_URL=https://api.example.com/api
# VITE_BACKEND_URL=https://api.example.com

# Google sign-in. Same client id as GOOGLE_CLIENT_ID on the server.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
