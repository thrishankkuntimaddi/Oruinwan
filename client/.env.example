# Vite App Environment Variables
# Note: Variables must start with VITE_ to be accessible in the browser

# API Configuration
VITE_API_URL=http://localhost:8080/api
VITE_BACKEND_URL=http://localhost:8080
# Desktop and tablet apps (vite build --mode app): the server they talk to. Empty: VITE_BACKEND_URL.
VITE_SERVER_URL=
# Product website (vite build --mode site): the web app that "Log in" and "Get started" open, in a
# new tab. Empty: they stay in the same tab and /login points to http://localhost:3000.
# (The server-hosted web build always opens its own /login in a new tab; app builds stay in one window.)
VITE_WEB_APP_URL=
VITE_API_TIMEOUT=10000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true

# Third-party Services
VITE_GOOGLE_ANALYTICS_ID=your_ga_id_here
VITE_SENTRY_DSN=your_sentry_dsn_here

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Other Configuration
VITE_APP_NAME=Oruinwan
VITE_VERSION=1.0.0

# Note: Never store sensitive secrets in client-side .env files
# as they will be exposed in the browser bundle!
