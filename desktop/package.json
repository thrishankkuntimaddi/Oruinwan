{
  "name": "oruinwan-desktop",
  "version": "1.2.0",
  "description": "Channels, direct messages, tasks, notes and Oruinwan AI for your team",
  "main": "electron/main.js",
  "desktopName": "oruinwan.desktop",
  "private": true,
  "homepage": "https://github.com/thrishankkuntimaddi/Oruniwan",
  "author": "Oruinwan",
  "license": "MIT",
  "scripts": {
    "start": "cross-env ELECTRON_IS_DEV=1 electron .",
    "start:bundled": "npm run bundle && electron .",
    "bundle": "node scripts/bundle-app.mjs",
    "build:mac": "npm run bundle && electron-builder --mac --publish never",
    "build:win": "npm run bundle && electron-builder --win --publish never",
    "build:linux": "npm run bundle && electron-builder --linux --publish never",
    "pack": "npm run bundle && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "cross-env": "7.0.3",
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.oruinwan.desktop",
    "productName": "Oruinwan",
    "copyright": "Copyright © 2026 Oruinwan",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "app/**/*",
      "assets/icon.png"
    ],
    "publish": null,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ],
      "artifactName": "Oruinwan-Mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Oruinwan"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Oruinwan-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Oruinwan"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "executableName": "oruinwan",
      "maintainer": "Oruinwan <https://github.com/thrishankkuntimaddi/Oruniwan>",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "Oruinwan-Linux.${ext}",
      "syncDesktopName": true
    }
  }
}
