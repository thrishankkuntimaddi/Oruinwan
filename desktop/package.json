{
  "name": "chttrix-desktop",
  "version": "1.0.0",
  "description": "Oruinwan Desktop App — Electron wrapper for the Oruinwan web client",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "cross-env ELECTRON_IS_DEV=1 electron .",
    "start:win": "cross-env ELECTRON_IS_DEV=1 electron .",
    "start:prod": "electron .",
    "icons": "node scripts/generate-icons.js",
    "prebuild": "node scripts/generate-icons.js",
    "build": "electron-builder --mac --win --linux",
    "build:mac": "node scripts/generate-icons.js && electron-builder --mac",
    "build:win": "node scripts/generate-icons.js && electron-builder --win",
    "build:linux": "node scripts/generate-icons.js && electron-builder --linux",
    "pack": "node scripts/generate-icons.js && electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.chttrix.desktop",
    "productName": "Oruinwan",
    "copyright": "Copyright © 2024 Oruinwan",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "protocols": [
      {
        "name": "Oruinwan",
        "schemes": ["oruinwan", "chttrix"]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://downloads.oruinwan.com/desktop"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Network",
      "mimeTypes": ["x-scheme-handler/oruinwan", "x-scheme-handler/chttrix"],
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": ["oruinwan", "electron", "desktop", "workspace"],
  "author": "Oruinwan Team",
  "license": "MIT"
}
